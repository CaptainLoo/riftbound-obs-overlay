{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "server/streamdeckWorker.js",
    "server/update-router.js",
    "server/update-apply.js",
    "electron/preload.cjs",
    "electron/updater/bootstrap.js",
    "scripts/*.mjs",
    "public/**/*.js",
    "tests/*.test.mjs"
  ],
  "project": [
    "server/**/*.js",
    "electron/**/*.{js,cjs}",
    "scripts/**/*.mjs",
    "public/**/*.js",
    "tests/**/*.mjs"
  ],
  "paths": {
    "/shared/*": [
      "public/shared/*"
    ]
  },
  "ignoreDependencies": [
    "jpeg-js"
  ],
  "ignoreBinaries": [
    "start"
  ]
}
